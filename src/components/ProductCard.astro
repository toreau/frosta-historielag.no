---
interface Props {
  name: string;
  description: string;
  price: number;
  image?: string;
}

import Image from "./Image.astro";
import site from "../data/site.json";

const { name, description, price, image } = Astro.props;
---

<div class="card group">
  {image && (
    <div class="aspect-[4/3] overflow-hidden bg-slate-100">
      <Image
        src={image}
        alt={name}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 sepia-[0.15]"
        loading="lazy"
        width={400} height={300}
        widths={[480]}
        sizes="400px"
      />
    </div>
  )}
  <div class="p-5">
    <h3 class="font-serif text-lg font-semibold text-forest-800">{name}</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
    <div class="mt-4 flex items-center justify-between">
      <span class="font-serif text-xl font-bold text-amber-600">{price > 0 ? `kr ${price},-` : "Pris på forespørsel"}</span>
      <a
        href={`mailto:${site.email}?subject=Bestilling: ${name}`}
        class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors"
      >
        Bestill &rarr;
      </a>
    </div>
  </div>
</div>
