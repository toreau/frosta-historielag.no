---
interface Props {
  title: string;
  date: string;
  time?: string;
  location?: string;
  description: string;
  image?: string;
}

import Image from "./Image.astro";

const { title, date, time, location, description, image } = Astro.props;

const months = [
  "januar", "februar", "mars", "april", "mai", "juni",
  "juli", "august", "september", "oktober", "november", "desember",
];
const parts = date.split("-");
const displayDate =
  parts.length === 3
    ? `${parseInt(parts[2])}. ${months[parseInt(parts[1]) - 1]} ${parts[0]}`
    : date;
---

<div class="card group flex flex-col overflow-hidden md:flex-row">
  {image && (
    <div class="md:w-56 shrink-0 overflow-hidden bg-slate-100">
      <Image
        src={image}
        alt={title}
        class="h-48 w-full object-cover md:h-full transition-transform duration-500 group-hover:scale-105 sepia-[0.15]"
        loading="lazy"
        width={800} height={450}
        widths={[480]}
        sizes="(max-width: 768px) 100vw, 260px"
      />
    </div>
  )}
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-500">
      <span class="flex items-center gap-1.5 font-medium text-amber-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {displayDate}
      </span>
      {time && <span>{time}</span>}
      {location && <span>— {location}</span>}
    </div>
    <h3 class="mt-3 font-serif text-xl font-semibold text-forest-800">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
  </div>
</div>
