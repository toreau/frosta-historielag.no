---
interface Props {
  title?: string;
  subtitle?: string;
  image?: string;
}

const { title, subtitle, image } = Astro.props;
import site from "../data/site.json";
import Image from "./Image.astro";

const segments = Astro.url.pathname.split("/").filter(Boolean);

const labelMap: Record<string, string> = {
  "om-oss": "Om oss",
  "historie": "Historie",
  "samlinger": "Konfirmanter",
  "slekt": "Slekt",
  "hva-skjer": "Hva skjer",
  "produkter": "Produkter",
  "frostabokene": "Frostabøkene",
  "frostabasen": "Frostabasen",
  "kalender": "Kalenderen",
  "arbok": "Årbok",
  "smykker": "Smykker",
  "bildegalleri": "Bildegalleri",
  "bli-medlem": "Bli medlem",
  "arsmeldinger": "Årsmeldinger",
};

function labelFor(seg: string): string {
  return labelMap[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1);
}

const breadcrumbJsonLd = segments.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Hjem",
      "item": Astro.site,
    },
    ...segments.map((seg, i) => {
      const isLast = i === segments.length - 1;
      const name = isLast && title ? title : labelFor(seg);
      const url = new URL("/" + segments.slice(0, i + 1).join("/"), Astro.site).href;
      return isLast
        ? { "@type": "ListItem", "position": i + 2, "name": name }
        : { "@type": "ListItem", "position": i + 2, "name": name, "item": url };
    }),
  ],
} : null;
---

{image ? (
  <section class="relative flex min-h-[30vh] items-center justify-center overflow-hidden bg-forest-900">
    <Image
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-45 sepia-[0.25]"
      loading="eager"
      fetchpriority="high"
      width={1600} height={400}
      widths={[480, 960, 1440]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-forest-950/60 via-forest-950/20 to-transparent" />
    <div class="container-narrow relative z-10 py-12 text-center text-cream-50">
      {title ? (
        <h1 class="font-serif text-3xl font-bold leading-tight md:text-5xl [text-shadow:0_2px_8px_rgba(0,0,0,0.4)]">
          {title}
        </h1>
      ) : (
        <h1 class="font-serif text-3xl font-bold leading-tight md:text-5xl [text-shadow:0_2px_8px_rgba(0,0,0,0.4)]">
          {site.name}
          <span class="mt-3 block font-sans text-lg font-normal italic text-cream-300 md:text-2xl [text-shadow:0_2px_6px_rgba(0,0,0,0.4)]">
            {site.tagline}
          </span>
        </h1>
      )}
      {subtitle && (
        <p class="mt-3 text-lg text-cream-300 md:text-xl [text-shadow:0_1px_4px_rgba(0,0,0,0.3)]">
          {subtitle}
        </p>
      )}
    </div>
  </section>
) : (
  <section class="border-b border-slate-200 bg-white">
    <div class="container-wide py-8 md:py-10">
      {segments.length > 0 && (
        <nav class="mb-3 flex items-center gap-1.5 text-sm text-slate-500" aria-label="Brødsmuler">
          <a href="/" class="hover:text-forest-600 transition-colors">Hjem</a>
          {segments.map((seg, i) => (
            <span class="flex items-center gap-1.5">
              <span class="text-slate-300 select-none">/</span>
              {i < segments.length - 1 ? (
                <a
                  href={"/" + segments.slice(0, i + 1).join("/")}
                  class="hover:text-forest-600 transition-colors"
                >
                  {labelFor(seg)}
                </a>
              ) : (
                <span class="text-slate-600">{title || labelFor(seg)}</span>
              )}
            </span>
          ))}
        </nav>
      )}

      {breadcrumbJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
      )}

      {title ? (
        <h1 class="font-serif text-3xl font-bold text-forest-800 md:text-4xl leading-tight">
          {title}
        </h1>
      ) : (
        <h1 class="font-serif text-3xl font-bold text-forest-800 md:text-4xl leading-tight">
          {site.name}
          <span class="ml-3 font-sans text-lg font-normal italic text-slate-500 align-middle">
            {site.tagline}
          </span>
        </h1>
      )}

      {subtitle && (
        <p class="mt-2 text-lg text-slate-500">
          {subtitle}
        </p>
      )}
    </div>
  </section>
)}
