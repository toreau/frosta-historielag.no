---
import site from "../data/site.json";
import Search from "./Search.astro";

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-cream-50/95 backdrop-blur-sm"
  x-data="{ open: false, searchOpen: false }"
>
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="flex items-center">
      <span class="inline-flex items-center rounded-lg bg-forest-800 px-3 py-1">
        <img
          src="/images/logo-small.png"
          alt="Frosta Historielag"
          class="h-9 w-auto"
          loading="eager"
          width="328" height="108"
        />
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Hovedmeny">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
            (item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href))
              ? "bg-slate-100 text-slate-900"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <button
        class="rounded-md p-2 text-slate-600 hover:bg-slate-100 transition-colors"
        x-on:click="open = false; searchOpen = !searchOpen; $nextTick(() => { if (searchOpen) $refs.searchInput.focus() })"
        aria-label="Åpne søk"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <a
        href="/bli-medlem"
        class="btn-primary text-sm"
      >
        Bli medlem
      </a>
    </div>

    <button
      class="lg:hidden rounded-md p-2 text-slate-600 hover:bg-slate-100"
      aria-label="Meny"
      x-on:click="open = !open"
    >
      <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg x-show="open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div
    class="lg:hidden border-t border-slate-200 bg-cream-50"
    x-show="open"
    x-transition
    x-cloak
  >
    <nav class="container-wide flex flex-col gap-1 py-3" aria-label="Mobilmeny">
      {site.nav.map((item) => (
        <a
          href={item.href}
          class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
            currentPath === item.href
              ? "bg-forest-100 text-forest-800"
              : "text-slate-600 hover:bg-slate-100"
          }`}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/bli-medlem"
        class="btn-primary mt-2 justify-center text-sm"
      >
        Bli medlem
      </a>
    </nav>
  </div>

  <!-- Mobile search trigger -->
  <div class="lg:hidden border-t border-slate-200 bg-cream-50">
    <div class="container-wide py-2">
      <button
        class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-600 hover:bg-slate-100"
        x-on:click="open = false; searchOpen = true; $nextTick(() => { if (searchOpen) $refs.searchInput?.focus() })"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Søk
      </button>
    </div>
  </div>
</header>

<!-- Full-width search bar (toggled from header icon or mobile Søk) -->
<div
  class="border-b border-slate-200 bg-white shadow-sm"
  x-show="searchOpen"
  x-transition:enter="transition ease-out duration-150"
  x-transition:enter-start="opacity-0 -translate-y-2"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-100"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 -translate-y-2"
  x-cloak
  x-trap="searchOpen"
  x-on:keydown.escape="searchOpen = false"
>
  <div class="container-wide py-4">
    <Search />
  </div>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
