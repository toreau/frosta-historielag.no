---
import site from "../data/site.json";
import Search from "./Search.astro";
import Image from "./Image.astro";

const currentPath = Astro.url.pathname;

const dropdownPaths = ["/om-oss", "/historie", "/arsmeldinger"];
const specialPaths = ["/", "/bli-medlem"];
const mainNavItems = site.nav.filter(item =>
  !dropdownPaths.includes(item.href) && !specialPaths.includes(item.href)
);
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-cream-50/95 backdrop-blur-sm"
  x-data="{ open: false, searchOpen: false }"
>
  <div class="container-wide flex h-16 items-center justify-between">
    <a href="/" class="flex items-center">
      <span class="inline-flex items-center rounded-lg bg-forest-800 px-3 py-1">
        <Image
          src="/images/logo-small.png"
          alt="Frosta Historielag"
          class="h-9 w-auto"
          loading="eager"
          width={328} height={108}
        />
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Hovedmeny" x-data="{ omossOpen: false }">
      <a
        href="/"
        class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
          currentPath === "/"
            ? "bg-slate-100 text-slate-900"
            : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        }`}
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        Hjem
      </a>

      <!-- Om oss dropdown -->
      <div
        class="relative"
        x-on:mouseenter="omossOpen = true"
        x-on:mouseleave="omossOpen = false"
        x-on:click.outside="omossOpen = false"
      >
        <button
          class={`rounded-md px-3 py-2 text-sm font-medium transition-colors flex items-center gap-1 ${
            currentPath.startsWith("/om-oss") || currentPath.startsWith("/historie") || currentPath.startsWith("/arsmeldinger")
              ? "bg-slate-100 text-slate-900"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          }`}
        >
          Om oss
          <svg x-bind:class="omossOpen && 'rotate-180'" class="h-3 w-3 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          x-show="omossOpen"
          x-transition
          x-cloak
          class="absolute left-0 top-full mt-1 min-w-[180px] rounded-lg border border-slate-200 bg-white py-1 shadow-lg"
        >
          <a href="/om-oss" class={`block px-4 py-2 text-sm transition-colors ${currentPath === "/om-oss" ? "bg-forest-50 text-forest-700" : "text-slate-600 hover:bg-slate-50"}`} aria-current={currentPath === "/om-oss" ? "page" : undefined}>Om laget</a>
          <a href="/historie" class={`block px-4 py-2 text-sm transition-colors ${currentPath.startsWith("/historie") ? "bg-forest-50 text-forest-700" : "text-slate-600 hover:bg-slate-50"}`} aria-current={currentPath.startsWith("/historie") ? "page" : undefined}>Historie</a>
          <a href="/arsmeldinger" class={`block px-4 py-2 text-sm transition-colors ${currentPath.startsWith("/arsmeldinger") ? "bg-forest-50 text-forest-700" : "text-slate-600 hover:bg-slate-50"}`} aria-current={currentPath.startsWith("/arsmeldinger") ? "page" : undefined}>Årsmeldinger</a>
        </div>
      </div>

      {mainNavItems.map((item) => (
        <a
          href={item.href}
          class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
            currentPath.startsWith(item.href)
              ? "bg-slate-100 text-slate-900"
              : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
          }`}
          aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/bli-medlem"
        class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
          currentPath.startsWith("/bli-medlem")
            ? "bg-slate-100 text-slate-900"
            : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"
        }`}
        aria-current={currentPath.startsWith("/bli-medlem") ? "page" : undefined}
      >
        Bli medlem
      </a>
    </nav>

    <div class="hidden lg:flex items-center gap-3">
      <button
        class="rounded-md p-2 text-slate-600 hover:bg-slate-100 transition-colors"
        x-on:click="open = false; searchOpen = !searchOpen; $nextTick(() => { if (searchOpen) $refs.searchInput.focus() })"
        aria-label="Åpne søk"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
      <a
        href="/bli-medlem"
        class="btn-primary text-sm"
      >
        Bli medlem
      </a>
    </div>

    <div class="flex items-center gap-1 lg:hidden">
      <button
        class="rounded-md p-2 text-slate-600 hover:bg-slate-100"
        aria-label="Åpne søk"
        x-on:click="open = false; searchOpen = !searchOpen; $nextTick(() => { if (searchOpen) $refs.searchInput?.focus() })"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <button
        class="rounded-md p-2 text-slate-600 hover:bg-slate-100"
        aria-label="Meny"
        x-on:click="open = !open"
      >
        <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div
    class="lg:hidden border-t border-slate-200 bg-cream-50"
    x-show="open"
    x-transition
    x-cloak
  >
    <nav class="container-wide flex flex-col gap-1 py-3" aria-label="Mobilmeny" x-data="{ mobOmossOpen: false }">
      <a
        href="/"
        class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
          currentPath === "/"
            ? "bg-forest-100 text-forest-800"
            : "text-slate-600 hover:bg-slate-100"
        }`}
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        Hjem
      </a>

      <!-- Mobile Om oss accordion -->
      <button
        class={`flex w-full items-center justify-between rounded-md px-3 py-2 text-sm font-medium transition-colors ${
          currentPath.startsWith("/om-oss") || currentPath.startsWith("/historie") || currentPath.startsWith("/arsmeldinger")
            ? "bg-forest-100 text-forest-800"
            : "text-slate-600 hover:bg-slate-100"
        }`}
        x-on:click="mobOmossOpen = !mobOmossOpen"
      >
        Om oss
        <svg x-bind:class="mobOmossOpen && 'rotate-180'" class="h-3 w-3 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div x-show="mobOmossOpen" x-cloak class="ml-4 flex flex-col gap-1 border-l-2 border-forest-200 pl-3">
        <a href="/om-oss" class={`rounded-md px-3 py-1.5 text-sm transition-colors ${currentPath === "/om-oss" ? "text-forest-700 font-medium" : "text-slate-600 hover:bg-slate-100"}`} aria-current={currentPath === "/om-oss" ? "page" : undefined}>Om laget</a>
        <a href="/historie" class={`rounded-md px-3 py-1.5 text-sm transition-colors ${currentPath.startsWith("/historie") ? "text-forest-700 font-medium" : "text-slate-600 hover:bg-slate-100"}`} aria-current={currentPath.startsWith("/historie") ? "page" : undefined}>Historie</a>
        <a href="/arsmeldinger" class={`rounded-md px-3 py-1.5 text-sm transition-colors ${currentPath.startsWith("/arsmeldinger") ? "text-forest-700 font-medium" : "text-slate-600 hover:bg-slate-100"}`} aria-current={currentPath.startsWith("/arsmeldinger") ? "page" : undefined}>Årsmeldinger</a>
      </div>

      {mainNavItems.map((item) => (
        <a
          href={item.href}
          class={`rounded-md px-3 py-2 text-sm font-medium transition-colors ${
            currentPath.startsWith(item.href)
              ? "bg-forest-100 text-forest-800"
              : "text-slate-600 hover:bg-slate-100"
          }`}
          aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/bli-medlem"
        class="btn-primary mt-2 justify-center text-sm"
      >
        Bli medlem
      </a>
    </nav>
  </div>

  <!-- Full-width search bar (toggled from header icon or mobile Søk) -->
  <div
    class="border-t border-slate-200 bg-white shadow-sm"
    x-show="searchOpen"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    x-cloak
    x-on:keydown.escape="searchOpen = false"
  >
    <div class="container-wide py-4">
      <Search />
    </div>
  </div>
</header>

<script defer src="/js/alpine.min.js"></script>
