---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getCollection } from "astro:content";
import { marked } from "marked";

export async function getStaticPaths() {
  const allPages = await getCollection("pages");
  const pages = allPages.filter((p) => p.data.section === "om-oss");
  return pages.map((p) => ({
    params: { slug: p.id.replace(/\.md$/, "") },
    props: { page: p },
  }));
}

const { page } = Astro.props;
const htmlContent = page.body ? marked.parse(page.body) : "";
---

<Layout title={page.data.title} description={page.data.title + " — Frosta Historielag"}>
  <Hero title={page.data.title} />

  <section class="page-section">
    <div class="container-wide max-w-3xl">
      <article class="prose prose-slate prose-lg max-w-none" set:html={htmlContent} />
      <div class="mt-12 border-t border-slate-200 pt-6">
        <a href="/om-oss" class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors">&larr; Tilbake til Om oss</a>
      </div>
    </div>
  </section>
</Layout>
