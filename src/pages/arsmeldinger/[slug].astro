---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import { getCollection } from "astro:content";
import { renderMarkdown } from "../../lib/markdown";

export async function getStaticPaths() {
  const reports = await getCollection("reports");
  return reports.map((r) => ({
    params: { slug: r.id.replace(/\.md$/, "") },
    props: { report: r },
  }));
}

const { report } = Astro.props;
const htmlContent = renderMarkdown(report.body);
---

<Layout title={report.data.title} description={`${report.data.title} — Frosta Historielag`}>
  <Hero title={report.data.title} subtitle={`Årsmøte ${report.data.year}`} />

  <section class="page-section">
    <div class="container-wide max-w-3xl">
      <article class="space-y-4 text-lg leading-relaxed text-slate-700" set:html={htmlContent} />
      <div class="mt-12 border-t border-slate-200 pt-6">
        <a href="/arsmeldinger" class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors">
          &larr; Tilbake til årsmeldinger
        </a>
      </div>
    </div>
  </section>
</Layout>
