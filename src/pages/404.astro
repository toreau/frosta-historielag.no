---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Siden finnes ikke" description="Siden du leter etter finnes ikke.">
  <section class="page-section">
    <div class="container-narrow text-center">
      <p class="font-serif text-8xl font-bold text-amber-500">404</p>
      <h1 class="mt-6 font-serif text-3xl font-bold text-forest-800">Siden finnes ikke</h1>
      <p class="mt-4 text-lg text-slate-600">
        Beklager, siden du leter etter finnes ikke eller har blitt flyttet.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary">Gå til forsiden</a>
        <a href="/hva-skjer" class="btn-secondary">Se hva som skjer</a>
      </div>
    </div>
  </section>
</Layout>
