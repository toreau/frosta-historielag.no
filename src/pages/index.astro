---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import EventCard from "../components/EventCard.astro";
import site from "../data/site.json";
import { getCollection } from "astro:content";

const events = await getCollection("events", ({ data }) => data.published);
events.sort((a, b) => b.data.date.localeCompare(a.data.date));
const upcomingEvents = events.slice(0, 2);
---

<Layout title="Hjem" description={site.tagline}>
  <Hero image="/images/tinghaugen-1945.jpg" />

  <section class="page-section">
    <div class="container-wide">
      <div class="grid gap-6 md:grid-cols-3">
        <a href="/bli-medlem" class="card group block p-0 overflow-hidden">
          <div class="flex items-center gap-4 p-6">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-forest-800">Bli medlem</h3>
              <p class="mt-1 text-sm text-slate-500">Enkeltmedlem kr {site.membership.single},- &bull; Familie kr {site.membership.family},-</p>
            </div>
          </div>
          <div class="border-t border-slate-100 bg-cream-50 px-6 py-3 text-sm font-medium text-forest-600 group-hover:text-forest-800 transition-colors">
            Meld deg inn &rarr;
          </div>
        </a>

        <a href="/produkter" class="card group block p-0 overflow-hidden">
          <div class="flex items-center gap-4 p-6">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-forest-100 text-forest-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-forest-800">Kj&oslash;p produkter</h3>
              <p class="mt-1 text-sm text-slate-500">Frostab&oslash;kene, Frostabasen, kalender, smykker</p>
            </div>
          </div>
          <div class="border-t border-slate-100 bg-cream-50 px-6 py-3 text-sm font-medium text-forest-600 group-hover:text-forest-800 transition-colors">
            Se alle produkter &rarr;
          </div>
        </a>

        <a href="/slekt" class="card group block p-0 overflow-hidden">
          <div class="flex items-center gap-4 p-6">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-sepia-light/30 text-sepia">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-xl font-semibold text-forest-800">Slektsgransking</h3>
              <p class="mt-1 text-sm text-slate-500">Finn dine r&oslash;tter &mdash; Frostabasen, kurs og kilder</p>
            </div>
          </div>
          <div class="border-t border-slate-100 bg-cream-50 px-6 py-3 text-sm font-medium text-forest-600 group-hover:text-forest-800 transition-colors">
            Start slektsgransking &rarr;
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 page-section">
    <div class="container-wide">
      <div class="flex items-center justify-between mb-10">
        <h2 class="font-serif text-3xl font-bold text-forest-800">Hva skjer</h2>
        <a href="/hva-skjer" class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors">
          Se alle arrangementer &rarr;
        </a>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {upcomingEvents.map((event) => (
          <EventCard
            title={event.data.title}
            date={event.data.date}
            time={event.data.time}
            location={event.data.location}
            description={event.body?.substring(0, 180) + "..." || ""}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container-wide">
      <div class="grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="font-serif text-3xl font-bold text-forest-800">Besøk oss</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Vi holder til på <strong>Tun, Frostavegen 1722, 7633 Frosta</strong>.
          </p>
          <div class="mt-4 space-y-2 text-slate-600">
            <div class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><strong>Åpent:</strong> {site.officeHours}</span>
            </div>
            <div class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <a href={`tel:${site.phone}`} class="hover:text-forest-600 transition-colors">{site.phone}</a>
            </div>
            <div class="flex items-start gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <a href={`mailto:${site.email}`} class="hover:text-forest-600 transition-colors break-all">{site.email}</a>
            </div>
          </div>
          <div class="mt-6">
            <a href="mailto:frosta.historielag@gmail.com" class="btn-secondary text-sm">
              Ta kontakt
            </a>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-forest-800">Om Frosta Historielag</h2>
          <p class="mt-4 text-lg leading-relaxed text-slate-600">
            Frosta Historielag ble stiftet <strong>9. mars 1924</strong> og har i over 100 år arbeidet for å ta vare på og formidle Frostas rike historie. Vi gir ut bøker, arrangerer kurs og foredrag, driver slektsgransking og forvalter et stort arkiv av fotografier og dokumenter.
          </p>
          <div class="mt-6">
            <a href="/om-oss" class="btn-secondary text-sm">
              Les mer om oss &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-forest-800 page-section text-cream-50">
    <div class="container-narrow text-center">
      <h2 class="font-serif text-3xl font-bold">Bli medlem i dag</h2>
      <p class="mt-4 text-lg leading-relaxed text-cream-300">
        Støtt arbeidet med å ta vare på Frostas historie. Som medlem får du årboka, medlemsnytt og invitasjoner til arrangementer.
      </p>
      <div class="mt-6 flex items-center justify-center gap-8 text-center">
        <div>
          <p class="font-serif text-3xl font-bold text-amber-300">kr {site.membership.single},-</p>
          <p class="text-sm text-cream-300">Enkeltmedlem / år</p>
        </div>
        <div>
          <p class="font-serif text-3xl font-bold text-amber-300">kr {site.membership.family},-</p>
          <p class="text-sm text-cream-300">Familie / år</p>
        </div>
      </div>
      <div class="mt-8">
        <a href="/bli-medlem" class="btn-primary text-lg">
          Bli medlem
        </a>
      </div>
    </div>
  </section>
</Layout>
