---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";

const books = await getCollection("products", ({ data }) =>
  data.published && data.category === "bok"
);
books.sort((a, b) => a.data.price - b.data.price);
---

<Layout title="Frostabøkene" description="13 bind med Frostas historie — lokalhistoriske bøker utgitt av Frosta Historielag.">
  <Hero
    title="Frostabøkene"
    subtitle="Lokalhistorie i 13 bind"
  />

  <section class="page-section">
    <div class="container-wide">
      <p class="text-lg text-slate-600 max-w-2xl">
        Frostabøkene er historielagets bokserie som dekker Frostas historie — gårder, slekter, hendelser og dagligliv gjennom tidene.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {books.map((book) => (
          <ProductCard
            name={book.data.name}
            description={book.body || "Historielagets bok om Frostas historie."}
            price={book.data.price}
          />
        ))}
      </div>

      <div class="mt-10 rounded-xl border-2 border-amber-200 bg-amber-50 p-6">
        <h2 class="font-serif text-lg font-semibold text-amber-800">Tilbud</h2>
        <ul class="mt-3 space-y-2 text-amber-700">
          <li><strong>Frostaboka III + IV:</strong> kr 500,-</li>
          <li><strong>Full serie (alle 13 bind):</strong> kr 4000,-</li>
        </ul>
        <p class="mt-3 text-sm text-amber-600">
          Bestill på <a href="mailto:frosta.historielag@gmail.com" class="font-medium underline">frosta.historielag@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
