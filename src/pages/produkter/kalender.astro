---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getCollection } from "astro:content";

const calendars = await getCollection("products", ({ data }) =>
  data.published && data.category === "kalender"
);
calendars.sort((a, b) => a.data.price - b.data.price);
---

<Layout title="Frostakalenderen" description="Årlig kalender med historiske bilder fra Frosta.">
  <Hero
    title="Frostakalenderen"
    subtitle="Historiske bilder — årets kalender"
  />

  <section class="page-section">
    <div class="container-wide">
      <p class="text-lg text-slate-600 max-w-2xl">
        Hvert år gir Frosta Historielag ut en kalender med historiske bilder fra bygda. Kalenderen inneholder gamle bilder med varierte temaer — idrett, landbruk, skole, dagligliv og mer.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {calendars.map((cal) => (
          <ProductCard
            name={cal.data.name}
            description={cal.body || "Kalender med historiske bilder fra Frosta."}
            price={cal.data.price}
            image={cal.data.image}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
