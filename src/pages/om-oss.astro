---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Image from "../components/Image.astro";
import site from "../data/site.json";
import { getCollection } from "astro:content";

const omOssPages = await getCollection("pages", ({ data }) =>
  data.section === "om-oss" && data.published
);
omOssPages.sort((a, b) => (b.data.date || "").localeCompare(a.data.date || ""));
---

<Layout title="Om oss" description="Om Frosta Historielag — styre, kontaktinfo og historien vår.">
  <Hero
    title="Om oss"
    subtitle="Frosta Historielag — stiftet 9. mars 1924"
  />

  <section class="page-section">
    <div class="container-wide">
      <h2 class="font-serif text-3xl font-bold text-forest-800">Vår historie</h2>
      <div class="mt-6 grid gap-8 md:grid-cols-3">
        <div class="md:col-span-2 space-y-4 text-lg leading-relaxed text-slate-600">
          <p>
            Frosta Historielag ble stiftet <strong>9. mars 1924</strong> da «nogle faa mænd» møttes for å diskutere dannelsen av et historielag for Frosta.
          </p>
          <p>
            Initiativtakeren var husmannen og lokalhistorikeren <strong>Hans A. Vold</strong> (1870–1962). Han ble også historielagets første formann — fra 1924 til 1935. Den samme Hans A. Vold tok på begynnelsen av 1900-tallet initiativ til å ta vare på gamle gjenstander som sto i fare for å forsvinne. Dette førte til opprettelsen av <strong>Frosta Bygdemuseum</strong> i 1908.
          </p>
          <p>
            For sitt utrettelige arbeid som lokalhistoriker og slektsgransker fikk Hans A. Vold <strong>Kongens Fortjenstmedalje i gull</strong> i 1952.
          </p>
        </div>
        <div class="md:col-span-1">
          <Image
            src="/images/hans-a-vold.jpg"
            alt="Hans A. Vold"
            class="rounded-xl shadow-md sepia-[0.15] w-full"
            loading="lazy"
            width={864} height={1200}
          />
          <p class="mt-2 text-center text-sm text-slate-500 italic">Hans A. Vold (1870–1962)</p>
          <p class="text-center text-xs text-slate-400">Stifter av Frosta Historielag og Frosta Bygdemuseum</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-100 page-section">
    <div class="container-wide">
      <h2 class="font-serif text-3xl font-bold text-forest-800 text-center">Heder og ære</h2>
      <p class="mt-4 text-center text-slate-600 max-w-2xl mx-auto">
        I Historielagets 100-årige historie har det vært lite fokus på «heder og ære» overfor enkeltpersoner — men noe har det blitt.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/om-oss/peder-ohlen/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Peder Ohlen</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
        <a href="/om-oss/bjorn-olav-juberg/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Bjørn Olav Juberg</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
        <a href="/om-oss/roar-lindgaard/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Roar Lindgaard</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
        <a href="/om-oss/finn-karlsen/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Finn Karlsen</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
        <a href="/om-oss/arnt-stavset/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Arnt Stavset</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
        <a href="/om-oss/kristian-risan/" class="card p-4 hover:border-forest-300 transition-colors no-underline">
          <h3 class="font-serif text-lg font-semibold text-forest-800">Kristian Risan</h3>
          <p class="mt-1 text-xs text-slate-500">Æresmedlem</p>
        </a>
      </div>

      <p class="mt-6 text-center text-sm text-slate-500">
        Utnevnt i forbindelse med Historielagets 100-årsjubileum 16. mars 2024.
      </p>

      {omOssPages.length > 0 && (
        <div class="mt-8 border-t border-slate-200 pt-8">
          <h3 class="font-serif text-xl font-semibold text-forest-800 text-center">Flere artikler</h3>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {omOssPages.map((p) => (
              <a
                href={`/om-oss/${p.id.replace(/\.md$/, "")}`}
                class="card p-4 hover:border-forest-300 transition-colors no-underline"
              >
                <span class="font-serif font-semibold text-forest-800">{p.data.title}</span>
                {p.data.date && (
                  <span class="mt-1 block text-xs text-slate-500">{p.data.date}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-6 flex justify-center">
        <Image
          src="/images/ildsjelprisen-2023.jpg"
          alt="Ildsjelprisen"
          class="rounded-xl shadow-md max-w-sm w-full"
          loading="lazy"
        />
      </div>
      <p class="mt-2 text-center text-sm text-slate-500">
        Ildsjelprisen: Bjørn Olav Juberg (2022), Lilly Eriksen (2023), Roar Lindgaard (2016)
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="container-wide">
      <h2 class="font-serif text-3xl font-bold text-forest-800 text-center">Styret</h2>
      <p class="mt-2 text-center text-slate-600">Valgt på årsmøtet 2025</p>

      <div class="mt-10 overflow-x-auto">
        <table class="w-full max-w-2xl mx-auto text-left">
          <thead>
            <tr class="border-b-2 border-forest-200">
              <th class="pb-3 font-serif text-lg font-semibold text-forest-800">Rolle</th>
              <th class="pb-3 font-serif text-lg font-semibold text-forest-800">Navn</th>
              <th class="pb-3 font-serif text-lg font-semibold text-forest-800">Telefon</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {site.board.map((member) => (
              <tr class="hover:bg-cream-50 transition-colors">
                <td class="py-3 font-medium text-slate-600">{member.role}</td>
                <td class="py-3 text-slate-800">{member.name}</td>
                <td class="py-3 text-sm text-slate-500">{member.phone}</td>
              </tr>
            ))}
            <tr>
              <td class="py-3 font-medium text-slate-600" colspan="3">
                <span class="font-semibold text-forest-700">Varamedlemmer:</span>
                {" "}
                {site.boardDeputies.map((d, i) => (
                  <>{d.name} ({d.phone}){i < site.boardDeputies.length - 1 ? " / " : ""}</>
                ))}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

</Layout>
