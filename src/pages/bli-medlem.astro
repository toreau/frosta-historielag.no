---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import site from "../data/site.json";
---

<Layout title="Bli medlem" description="Bli medlem i Frosta Historielag og støtt arbeidet med lokalhistorie.">
  <Hero
    title="Bli medlem"
    subtitle="Støtt arbeidet med Frostas historie"
  />

  <section class="page-section">
    <div class="container-wide">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-serif text-3xl font-bold text-forest-800">Medlemskap</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            <div class="card p-6 text-center">
              <p class="font-serif text-4xl font-bold text-amber-600">kr {site.membership.single},-</p>
              <p class="mt-2 font-medium text-slate-700">Enkeltmedlem</p>
              <p class="mt-1 text-sm text-slate-500">Per år</p>
            </div>
            <div class="card p-6 text-center">
              <p class="font-serif text-4xl font-bold text-amber-600">kr {site.membership.family},-</p>
              <p class="mt-2 font-medium text-slate-700">Familie</p>
              <p class="mt-1 text-sm text-slate-500">Per år</p>
            </div>
          </div>

          <div class="mt-8 space-y-4 text-slate-600">
            <h3 class="font-serif text-xl font-semibold text-forest-700">Som medlem får du:</h3>
            <ul class="list-disc pl-5 space-y-2">
              <li>Historielagets årbok tilsendt</li>
              <li>Medlemsnytt med informasjon om arrangementer</li>
              <li>Invitasjon til årsmøte og medlemsarrangementer</li>
              <li>Mulighet til å delta i historielagets arbeid</li>
            </ul>
          </div>

          <div class="mt-8 rounded-xl bg-cream-100 p-6">
            <h3 class="font-serif text-lg font-semibold text-forest-700">Betaling</h3>
            <p class="mt-2 text-slate-600">
              <strong>Vipps:</strong> #{site.vipps}<br />
              <strong>Kontonr:</strong> {site.account}
            </p>
            <p class="mt-2 text-sm text-slate-500">
              Husk å oppgi navn og «medlemskap» ved betaling.
            </p>
          </div>
        </div>

        <div>
          <h2 class="font-serif text-3xl font-bold text-forest-800">Meld deg inn</h2>
          <p class="mt-2 text-slate-600">Fyll ut skjemaet så kontakter vi deg.</p>

          <form
            action="https://formsubmit.co/frosta.historielag@gmail.com"
            method="POST"
            class="mt-8 space-y-5"
          >
            <input type="hidden" name="_subject" value="Ny medlemsinnmelding — Frosta Historielag" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="text" name="_honey" style="display:none" />

            <div>
              <label for="name" class="block text-sm font-medium text-slate-700">Navn *</label>
              <input
                type="text"
                name="name"
                id="name"
                required
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm focus:border-forest-500 focus:ring-2 focus:ring-forest-200 focus:outline-none transition-colors"
                placeholder="Ditt fulle navn"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-700">E-post *</label>
              <input
                type="email"
                name="email"
                id="email"
                required
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm focus:border-forest-500 focus:ring-2 focus:ring-forest-200 focus:outline-none transition-colors"
                placeholder="din@epost.no"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-slate-700">Telefon</label>
              <input
                type="tel"
                name="phone"
                id="phone"
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm focus:border-forest-500 focus:ring-2 focus:ring-forest-200 focus:outline-none transition-colors"
                placeholder="Ditt telefonnummer"
              />
            </div>

            <div>
              <label for="type" class="block text-sm font-medium text-slate-700">Medlemskapstype</label>
              <select
                name="type"
                id="type"
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm focus:border-forest-500 focus:ring-2 focus:ring-forest-200 focus:outline-none transition-colors"
              >
                <option value="single">Enkeltmedlem (kr {site.membership.single},-)</option>
                <option value="family">Familie (kr {site.membership.family},-)</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700">Melding (valgfri)</label>
              <textarea
                name="message"
                id="message"
                rows="3"
                class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-slate-800 shadow-sm focus:border-forest-500 focus:ring-2 focus:ring-forest-200 focus:outline-none transition-colors"
                placeholder="Eventuelle spørsmål eller kommentarer"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full justify-center text-center text-lg">
              Send innmelding
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
