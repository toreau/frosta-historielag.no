---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getCollection } from "astro:content";
import site from "../data/site.json";

import PhotoGrid from "../components/PhotoGrid.astro";

const gallery = await getCollection("gallery");

const gamleBilder = gallery.map((entry) => ({
  src: entry.data.src,
  alt: entry.data.alt,
  caption: entry.data.caption,
}));
---

<Layout title="Bildegalleri" description="Historiske og nyere bilder fra Frosta.">
  <Hero
    title="Bildegalleri"
    subtitle="Gamle og nyere bilder fra Frosta"
  />

  <section class="page-section">
    <div class="container-wide">
      <h2 class="font-serif text-3xl font-bold text-forest-800 text-center">Gamle bilder</h2>
      <p class="mt-4 text-center text-slate-600">Historiske fotografier fra Frosta — portretter, landskap og dagligliv.</p>
      <PhotoGrid photos={gamleBilder} />
    </div>
  </section>

  <section class="bg-cream-100 page-section">
    <div class="container-narrow text-center">
      <h2 class="font-serif text-3xl font-bold text-forest-800">Filmer</h2>
      <p class="mt-4 text-lg text-slate-600">
        Historielaget har også en samling av historiske filmer fra Frosta.
      </p>
      <div class="mt-6">
        <a href={`mailto:${site.email}`} class="btn-primary">
          Ta kontakt
        </a>
      </div>
    </div>
  </section>
</Layout>
