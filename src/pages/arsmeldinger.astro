---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import { getCollection } from "astro:content";

const rawReports = await getCollection("reports", ({ data }) => data.published);
const rapporter = rawReports
  .map((r) => ({
    slug: r.id.replace(/\.md$/, ""),
    year: r.data.year,
    title: r.data.title,
  }))
  .sort((a, b) => b.year - a.year);
---

<Layout title="Årsmeldinger" description="Årsmeldinger fra Frosta Historielag 2022–2025.">
  <Hero
    title="Årsmeldinger"
    subtitle="Arkiv over historielagets årsmeldinger"
  />

  <section class="page-section">
    <div class="container-narrow">
      <p class="text-lg text-slate-600">
        Her finner du historielagets årsmeldinger fra de siste årene. Årsmeldingene gir et sammendrag av aktiviteten i laget og legges frem på årsmøtet hvert år.
      </p>

      <div class="mt-10 space-y-3">
        {rapporter.map((r) => (
          <a
            href={`/arsmeldinger/${r.slug}`}
            class="card flex items-center justify-between p-5 hover:border-forest-300 no-underline"
          >
            <div>
              <h3 class="font-serif text-lg font-semibold text-forest-800">{r.title}</h3>
              <p class="text-sm text-slate-500">Årsmøte {r.year}</p>
            </div>
            <span class="text-forest-500 text-xl">&rarr;</span>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-xl bg-cream-100 p-6 text-center">
        <p class="text-slate-600">
          Årsmeldingene finnes også i trykt format. Ta kontakt for eldre utgaver.
        </p>
      </div>
    </div>
  </section>
</Layout>
